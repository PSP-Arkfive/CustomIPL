PYTHON = $(shell which python3)
PSPDEV = $(shell psp-config --pspdev-path)
CFWSDK = $(PSPDEV)/share/psp-cfw-sdk
BUILDTOOLS = $(CFWSDK)/build-tools

.PHONY: all ipl_660

all: ipl_660

ipl_660:
# Nand
	$(MAKE) -C $(CIPL_ROOT)/Payloadex/LME/Nand clean
	$(MAKE) PSP_FW=660 -C $(CIPL_ROOT)/Payloadex/LME/Nand
	$(MAKE) PSP_MODEL=01G PSP_FW=660 PSP_CFW=LME -C $(CIPL_ROOT)/NewIPL
	$(MAKE) PSP_MODEL=02G PSP_FW=660 PSP_CFW=LME -C $(CIPL_ROOT)/NewIPL
	$(MAKE) PSP_MODEL=03G PSP_FW=660 PSP_CFW=LME -C $(CIPL_ROOT)/NewIPL
	$(MAKE) PSP_MODEL=04G PSP_FW=660 PSP_CFW=LME -C $(CIPL_ROOT)/NewIPL
	$(MAKE) PSP_MODEL=05G PSP_FW=660 PSP_CFW=LME -C $(CIPL_ROOT)/NewIPL
	$(MAKE) PSP_MODEL=07G PSP_FW=660 PSP_CFW=LME -C $(CIPL_ROOT)/NewIPL
	$(MAKE) PSP_MODEL=09G PSP_FW=660 PSP_CFW=LME -C $(CIPL_ROOT)/NewIPL
	$(MAKE) PSP_MODEL=11G PSP_FW=660 PSP_CFW=LME -C $(CIPL_ROOT)/NewIPL
# pkg
	cd $(CIPL_ROOT) && $(PYTHON) $(BUILDTOOLS)/pack/pack.py -p dist/CustomIPL/CIPL660.LME Build/pkg_660.txt -s
